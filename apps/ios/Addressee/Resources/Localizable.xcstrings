    "keys.details.secureEnclave.deviceUnlocked" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This legacy key requires only an unlocked device. Its original access control has not been upgraded to biometric authorization."
