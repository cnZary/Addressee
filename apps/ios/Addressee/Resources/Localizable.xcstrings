    "generation.secureEnclave.hybrid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No OpenPGP password is required. New device-bound subkeys require Face ID or Touch ID for private-key operations; their private keys never enter Rust or software storage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需设置 OpenPGP 密码。新的设备绑定子钥在进行私钥操作时需要面容 ID 或触控 ID；其私钥不会进入 Rust 或软件存储。"
          }
        }
      }
    },
