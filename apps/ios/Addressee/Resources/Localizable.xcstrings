    "keys.details.secureEnclave.biometryCurrentSet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private-key operations require the currently enrolled biometrics. Changing enrollment can permanently invalidate the key."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私钥操作需要当前已登记的生物识别信息。更改登记信息可能使密钥永久失效。"
          }
        }
      }
