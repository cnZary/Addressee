    "keys.delete.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the certificate and its protected private material from this device. This cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从此设备删除证书及受保护的私钥材料，此操作无法撤销。"
          }
        }
      }
    },
    "keys.delete.secureEnclaveMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes the device-bound signing and encryption private keys as well as the protected software primary key. Messages encrypted only to the deleted hardware subkey cannot be recovered."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除设备绑定的签名和加密私钥，以及受保护的软件主钥。仅加密到已删除硬件子钥的消息将无法恢复。"
          }
        }
      }
    },
