      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure Enclave operations require a correctly signed physical device. They are not enabled by software-key support."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure Enclave 操作需要正确签名的实体设备，不会因支持软件密钥而自动启用。"
          }
        }
      }
    },
    "security.export.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets the default for newly generated or imported software keys. Each key retains its own export policy, enforced below the UI. This is not a hardware guarantee."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置新生成或导入软件密钥的默认导出策略。每个密钥保留自己的策略，并由界面以下的安全层强制执行；这不是硬件保证。"
          }
        }
      }
    },
    "security.export.software" : {
      "localizations" : {
