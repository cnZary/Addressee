    "generation.secureEnclave.primaryLifecycle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certification primary key remains protected software material, not Secure Enclave-backed. Its one-time internal protection password is discarded after generation, so it cannot later certify, revoke, or recover this certificate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "认证主钥仍是受保护的软件材料，不在 Secure Enclave 中。一次性内部保护密码在生成后销毁，因此该主钥之后不能再用于认证、吊销或恢复此证书。"
          }
        }
      }
    },
