        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The security key is linked to this public certificate. The connection is now closed; Addressee reconnects for private-key operations or explicitly requested device management."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全密钥已关联到以下公钥证书。当前连接已关闭；应用会在私钥操作或您明确请求设备管理时重新连接。"
          }
        }
      }
    },
    "hardware.managementPending" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card key generation, key import, algorithm reconfiguration, and factory reset are not implemented."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡内密钥生成、导入、算法重配置和恢复出厂设置尚未实现。"
          }
        }
      }
    },
    "hardware.nfc.alert" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
