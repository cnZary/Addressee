{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "A row in a picker view that displays the name of a cryptographic algorithm and a unique identifier for a hardware cryptographic component.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "about.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addressee is a native OpenPGP application for key management, signatures, and encryption."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addressee 是用于 OpenPGP 密钥管理、签名和加密的原生应用。"
          }
        }
      }
    },
