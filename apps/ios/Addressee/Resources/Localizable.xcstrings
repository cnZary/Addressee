    "application.multipleHardwareKeysNote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, USB operations automatically use the only available reader. Turn on to choose a reader explicitly when multiple readers are connected. This does not limit linked certificates or hardware keys."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，USB 操作将自动使用唯一可用的读卡器。连接多个读卡器时，可开启此模式并明确选择。此选项不限制可关联的证书或硬件密钥数量。"
          }
        }
      }
    },
