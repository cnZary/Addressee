    "hardware.readOnlyConnectionNote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFC and USB link the card to a public certificate and reconnect on demand for private-key operations or explicitly requested device management. Linking only reads public slot data and closes the session. PINs or touch policies change only after your explicit management action."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFC 和 USB 用于将卡片关联到公钥证书，并在私钥操作或您明确请求设备管理时按需重连。关联仅读取公开槽位数据并关闭会话；只有在您明确执行管理操作时，才会修改 PIN 或触摸策略。"
          }
        }
      }
    },
